#!/usr/bin/env bash

set -e
set -a

PROJECT_DIR=$(pwd)
DEPLOY_DIR="$PROJECT_DIR/deploy"
ENV_DIR="$PROJECT_DIR/environment"
PROD_ENV="$ENV_DIR/env.prod"
GENERATED_COMPOSE_DIR="$DEPLOY_DIR/compose/generated"

source $ENV_DIR/env.base
source $ENV_DIR/env.dev

if [ -f "$PROJECT_DIR/.env" ]; then
    source $PROJECT_DIR/.env
fi

set +a

# env.dev is sourced above, so drop its variables before loading env.base + env.prod
load_prod_env() {
    unset $(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$ENV_DIR/env.dev" | cut -d= -f1)
    set -a
    source $ENV_DIR/env.base
    source $PROD_ENV
    if [ -f "$PROJECT_DIR/.env" ]; then
        source $PROJECT_DIR/.env
    fi
    set +a
    PROD_DIR="/app/$PROJECT_NAME"
    DOCKER_IMAGE_PREFIX="$REGISTRY_HOSTNAME/$REGISTRY_NAMESPACE/$PROJECT_NAME"
}

require_deploy_json() {
    if [ ! -f "$PROJECT_DIR/deploy.json" ]; then
        echo "Error: deploy.json is required but was not found." >&2
        echo "  Expected path: $PROJECT_DIR/deploy.json" >&2
        echo "  Create deploy.json in the project root. See deploy/README.md for examples." >&2
        exit 1
    fi
}

require_deploy_json

generate_compose_files() {
    PYTHONPATH="$DEPLOY_DIR" python3.15 "$DEPLOY_DIR/launch_command.py" generate_compose
}

generate_compose_files

# Enabled components from deploy.json: DJANGO_ENABLED / FASTAPI_ENABLED / NEXTJS_ENABLED (yes|no),
# COMPONENTS (dev compose service names), FASTAPI_MIGRATE_COMMAND, OPENAPI_URL.
eval "$(PYTHONPATH="$DEPLOY_DIR" python3.15 "$DEPLOY_DIR/scripts/shell_config.py")"

require_component() {
    local name="$1" enabled="$2"
    if [ "$enabled" != "yes" ]; then
        echo "Error: '$name' is not enabled in deploy.json" >&2
        exit 1
    fi
}

DEV_COMPOSE="docker-compose -f $GENERATED_COMPOSE_DIR/dev.yml --env-file=$ENV_DIR/env.base --env-file=$ENV_DIR/env.dev"
BALANCER_COMPOSE="docker-compose -f $GENERATED_COMPOSE_DIR/dev_balancer.yml"

DEV_SUPERUSER_PASSWORD="devpass"
PROJECT_TEMPLATE_DIR="$HOME/projects/project_template"

is_in_list() {
    local target="$1"
    shift
    local list=("$@")

    for item in "${list[@]}"; do
        if [[ "$item" == "$target" ]]; then
            return 0
        fi
    done

    return 1  # false
}

PY_COMMANDS=("initprod" "deploybalancer" "deployprod" "certprod" "s3backupprod" "s3restoreprod" "s3backupdev" "s3restoredev" "s3createdevbucket" "update_dev_nginx" "generate_compose")
# Exit code of `ensure_dev_balancer` meaning "nginx config changed, restart the balancer"
# (NGINX_CHANGED_EXIT_CODE in scripts/dev_balancer.py).
NGINX_CHANGED_EXIT_CODE=10

PROD_DIR="/app/$PROJECT_NAME"
DOCKER_IMAGE_PREFIX="$REGISTRY_HOSTNAME/$REGISTRY_NAMESPACE/$PROJECT_NAME"

if [ $1 = "django" ]; then
    require_component django "$DJANGO_ENABLED"
    $DEV_COMPOSE run --rm django python manage.py "${@:2}"
elif [ $1 = "rebuild" ]; then
    $DEV_COMPOSE down
    $DEV_COMPOSE build $COMPONENTS
    if [ "$NEXTJS_ENABLED" = "yes" ]; then
        $DEV_COMPOSE run --rm -i nextjs sh -c "rm -rf node_modules package-lock.json && npm install"
    fi
    $DEV_COMPOSE up -d
elif [ $1 = "migrate" ]; then
    if [ "$DJANGO_ENABLED" = "yes" ]; then
        $DEV_COMPOSE run --rm django python manage.py migrate "${@:2}"
    fi
    if [ "$FASTAPI_ENABLED" = "yes" ] && [ -n "$FASTAPI_MIGRATE_COMMAND" ]; then
        $DEV_COMPOSE run --rm fastapi sh -c "$FASTAPI_MIGRATE_COMMAND"
    fi
elif [ $1 = "up" ]; then
    # Certificates, /etc/hosts and the project's nginx config are created/updated when missing
    # or outdated (sudo is asked only then); a changed config is validated before the reload.
    set +e
    PYTHONPATH="$DEPLOY_DIR" python3.15 "$DEPLOY_DIR/launch_command.py" ensure_dev_balancer
    ENSURE_STATUS=$?
    set -e
    if [ $ENSURE_STATUS -ne 0 ] && [ $ENSURE_STATUS -ne $NGINX_CHANGED_EXIT_CODE ]; then
        exit $ENSURE_STATUS
    fi
    $BALANCER_COMPOSE up -d
    if [ $ENSURE_STATUS -eq $NGINX_CHANGED_EXIT_CODE ]; then
        $BALANCER_COMPOSE restart
    fi
    $DEV_COMPOSE up -d
elif [ $1 = "sh" ]; then
    $DEV_COMPOSE exec $2 bash
elif [ $1 = "test" ]; then
    if [ "$DJANGO_ENABLED" = "yes" ]; then
        $DEV_COMPOSE run --rm django pytest
    fi
    if [ "$FASTAPI_ENABLED" = "yes" ]; then
        $DEV_COMPOSE run --rm fastapi pytest
    fi
elif [ $1 = "format" ]; then
    require_component django "$DJANGO_ENABLED"
    $DEV_COMPOSE run --rm django sh -c 'isort . && black .'
elif [ $1 = "tmux" ]; then
    $DEPLOY_DIR/tmux_dev.sh $COMPONENTS
elif [ $1 = "devsuperuser" ]; then
    require_component django "$DJANGO_ENABLED"
    $DEV_COMPOSE run --rm django sh -c "export DJANGO_SUPERUSER_PASSWORD='devpass' && python manage.py createsuperuser --noinput --username $2 --email $2@$2.com"
elif [ $1 = "buildtest" ]; then
    docker build . --file=dev-scripts/Dockerfile.playwright --tag $PROJECT_NAME-playwright
elif [ $1 = "runtest" ]; then
    docker run -it --rm --hostname=$PROJECT_NAME-tests --name=$PROJECT_NAME-tests -v .:/app/src --ipc=host --network=$PROJECT_NAME $PROJECT_NAME-playwright npx playwright test
elif [ $1 = "generatetypes" ]; then
    require_component nextjs "$NEXTJS_ENABLED"
    $DEV_COMPOSE exec nextjs npx -y openapi-typescript $OPENAPI_URL --output api/apiTypes.ts
elif [ $1 = "dumpprod" ]; then
    load_prod_env
    ssh root@$PROJECT_DOMAIN "docker run --rm -i -e PGPASSWORD=$DATABASE_PASSWORD postgres:16.15-alpine pg_dump -U $DATABASE_USER -h $DATABASE_HOST -p $DATABASE_PORT $DATABASE_NAME" > backup/$PROJECT_NAME.sql
elif [ $1 = "dumpdev" ]; then
    $DEV_COMPOSE exec postgres pg_dump --username=$PROJECT_NAME $PROJECT_NAME > backup/${PROJECT_NAME}dev.sql
elif [ $1 = "restoreprod" ]; then
    load_prod_env
    ssh root@$PROJECT_DOMAIN "docker run --rm -i -e PGPASSWORD=$DATABASE_PASSWORD postgres:16.15-alpine psql -U $DATABASE_USER -h $DATABASE_HOST -p $DATABASE_PORT -d $2" < $3
elif [ $1 = "restoredev" ]; then
    docker run --rm -i --network=$PROJECT_NAME -e PGPASSWORD=$DATABASE_PASSWORD postgres:16.15-alpine psql -U $DATABASE_USER -h $DATABASE_HOST -p $DATABASE_PORT $DATABASE_NAME < backup/${PROJECT_NAME}dev.sql
elif [ $1 = "deploystage" ]; then
    source $DEPLOY_DIR/env.stage
    $DEPLOY_DIR/deploy.sh $DEPLOY_DIR/env.stage
elif [ $1 = "updatenginx" ]; then
    PYTHONPATH="$DEPLOY_DIR" python3.15 $DEPLOY_DIR/launch_command.py update_dev_nginx
    $BALANCER_COMPOSE restart
elif [ $1 = "nginx" ]; then
    $BALANCER_COMPOSE "${@:2}"
elif [ $1 = "fastapiprod" ]; then
    require_component fastapi "$FASTAPI_ENABLED"
    load_prod_env
    ssh root@$PROJECT_DOMAIN "docker run --rm -i --env-file=$PROD_DIR/env.base --env-file=$PROD_DIR/env $DOCKER_IMAGE_PREFIX-fastapi ${@:2}"
elif [ $1 = "djangoprod" ]; then
    require_component django "$DJANGO_ENABLED"
    load_prod_env
    ssh root@$PROJECT_DOMAIN "docker run --rm -i --env-file=$PROD_DIR/env.base --env-file=$PROD_DIR/env $DOCKER_IMAGE_PREFIX-django python manage.py ${@:2}"
elif [ $1 = "logsprod" ]; then
    load_prod_env
    ssh root@$PROJECT_DOMAIN "docker service logs ${PROJECT_NAME}_${PROJECT_NAME}-${2}"
elif [ $1 = "gencerts" ]; then
    python3.15 $DEPLOY_DIR/generate_dev_certificates.py
    $BALANCER_COMPOSE restart
elif is_in_list $1 "${PY_COMMANDS[@]}"; then
    PYTHONPATH="$DEPLOY_DIR" python3.15 $DEPLOY_DIR/launch_command.py $1
elif [ $1 = "updatetemplate" ]; then
    load_prod_env
    $PROJECT_TEMPLATE_DIR/update_template.sh -t django_nextjs_template -n $PROJECT_NAME -r $PROJECT_DIR -d $PROJECT_DOMAIN
elif [ $1 = "updatesubmodules" ]; then
    git submodule status
    git submodule update --init --recursive --remote
else
    $DEV_COMPOSE $@
fi
